# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────
# PostgreSQL connection string. Leave empty in development to use the embedded
# PGlite database stored in PGLITE_DIR (real Postgres compiled to WASM — no install needed).
DATABASE_URL=
# DATABASE_URL=postgres://tracker:tracker@localhost:5432/tracker
PGLITE_DIR=./.pglite

# ── Security (REQUIRED in production, min 32 chars) ─────
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ENCRYPTION_KEY=change-me-to-another-long-random-string-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TTL_REMEMBER_SECONDS=2592000
REFRESH_TTL_DEFAULT_SECONDS=43200
COOKIE_SECURE=false

# ── Google login (optional) ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Passkeys / WebAuthn ──────────────────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Tracker
WEBAUTHN_ORIGIN=http://localhost:3000

# ── File storage (local driver) ─────────────────────────
STORAGE_DIR=./storage

# ── Email (optional; without SMTP emails are logged only) ─
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Tracker <no-reply@tracker.local>

# ── Payments (optional) ─────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Background jobs ─────────────────────────────────────
# true = the API process also runs the job worker; false = run `npm run worker` separately
WORKER_INLINE=true
LOG_LEVEL=info
